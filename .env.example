# ====================================================================
# 🎟️ Gemini Media Pass - Configuration (.env)
# ====================================================================

# --------------------------------------------------------------------
# ⚡ MODEL SELECTION & COST OPTIMIZATION (Flash vs. Pro)
# --------------------------------------------------------------------
# Default tier for video, audio, and multimodal inspection: 'flash' or 'pro'
# 'flash' is recommended: 97% cheaper (~$0.075/1M tokens vs ~$3.50/1M tokens),
# ultra-fast, and has the exact same 1M+ token video/audio context window.
GMP_DEFAULT_TIER=flash

# Specific override for video analysis tools (gemini_video):
GMP_VIDEO_TIER=flash

# Specific model overrides (optional):
# GEMINI_API_MODEL_FLASH=gemini-3.8-flash-high
# GEMINI_API_MODEL_PRO=gemini-3.1-pro-high

# --------------------------------------------------------------------
# 💳 BILLING & AUTHENTICATION
# --------------------------------------------------------------------
# Priority 1: Google AI Subscription (Free via Antigravity CLI 'agy')
# If 'agy' is installed and authenticated, analysis calls use your subscription
# and cost $0.00 in Google Cloud API credits.

# Priority 2: Google Cloud Gemini API Key (Pay-as-you-go fallback)
# Get a free key at: https://aistudio.google.com
# WARNING: If agy is not installed or times out, calls fall back to this key
# and consume Google Cloud API credits. To strictly prevent API charges,
# leave this unset or commented out.
# GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------
# 🎬 GOOGLE FLOW (Veo Video Generation)
# --------------------------------------------------------------------
# Uses your Google AI Pro/Ultra subscription credit pool.
# Run: python -m gemini_media_pass_mcp.auth to sign in via Chrome.
# Session tokens are cached in ~/.gflow.
# GMP_FLOW_MAX_CREDITS=40                                  # refuse Flow calls that would cost more

# --------------------------------------------------------------------
# 🛡️ SAFETY & ADVANCED SETTINGS
# --------------------------------------------------------------------
# GMP_TIMEOUT_SECONDS=180                                  # call timeout in seconds
# BRIDGE_URL=http://127.0.0.1:8000/v1/chat/completions   # opt-in local bridge, off when unset
# GMP_AGY_UNSAFE=1                                         # lets agy auto-approve commands; not recommended
